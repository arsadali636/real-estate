# Django Settings
DJANGO_SECRET_KEY=your-production-secret-key-here
DJANGO_DEBUG=False
ALLOWED_HOSTS=your-app-name.onrender.com,localhost,127.0.0.1

# Database Configuration (PostgreSQL)
# Format: postgresql://username:password@hostname:5432/dbname
DATABASE_URL=postgresql://estateflow:your_secure_password@dpg-xxxx.render.com:5432/estateflow_crm

# CORS & CSRF
CORS_ALLOWED_ORIGINS=https://estateflow-crm.vercel.app,http://localhost:3000
CSRF_TRUSTED_ORIGINS=https://estateflow-crm.vercel.app,https://your-app-name.onrender.com
